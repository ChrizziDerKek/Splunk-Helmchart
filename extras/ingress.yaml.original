apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: splunk-web
  namespace: data-stack
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - splunk.example.site
        - www.splunk.example.site
      secretName: splunk-web-tls
  rules:
    - host: splunk.example.site
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: splunk-web
                port:
                  number: 8000
    - host: www.splunk.example.site
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: splunk-web
                port:
                  number: 8000
