apiVersion: v1
kind: PersistentVolume
metadata:
  name: splunk-etc-pv
spec:
  capacity:
    storage: 400Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: splunk-local
  local:
    path: /k3s/splunk/data/etc
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - my-hostname-1337
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: splunk-var-pv
spec:
  capacity:
    storage: 400Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: splunk-local
  local:
    path: /k3s/splunk/data/var
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - my-hostname-1337
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: splunk-etc
  namespace: data-stack
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: splunk-local
  resources:
    requests:
      storage: 400Gi
  volumeName: splunk-etc-pv
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: splunk-var
  namespace: data-stack
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: splunk-local
  resources:
    requests:
      storage: 400Gi
  volumeName: splunk-var-pv
